@import "./inspect.wxss";

.page {
  min-height: 100vh;
  background: #eeeff1;
}

.hero {
  position: relative;
  background: #03234b;
  color: #ffffff;
  padding: 24rpx 32rpx 28rpx;
}

.hero-accent {
  position: absolute;
  top: 0;
  right: 0;
  width: 12rpx;
  height: 80rpx;
  background: #ffd200;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.brand-logo {
  width: 160rpx;
  height: 86rpx;
  flex-shrink: 0;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: #c0c9ce;
  text-transform: uppercase;
}

.db-pill {
  font-size: 22rpx;
  color: #c0c9ce;
}

.yellow-bar {
  background: #ffd200;
  color: #03234b;
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
}

.lead {
  font-size: 26rpx;
  line-height: 1.5;
  color: #c0c9ce;
}

.message-bar {
  background: #03234b;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.45;
  padding: 12rpx 32rpx 20rpx;
}

.body {
  padding: 20rpx 24rpx 48rpx;
}

.modes {
  display: flex;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.mode {
  flex: 1;
  min-height: 88rpx;
  background: #03234b;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.mode.is-active {
  background: #ffd200;
  color: #03234b;
}

.mode-head {
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.mode-hint {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #425978;
  line-height: 1.4;
}

.banner {
  background: #ffffff;
  color: #03234b;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.banner.error {
  background: #eeeff1;
}

.panel {
  background: #ffffff;
  margin-bottom: 0;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
}

.nl-box {
  padding: 24rpx 24rpx 0;
}

.nl-box textarea {
  min-height: 140rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #03234b;
  border: 2rpx solid #dbdee1;
  padding: 16rpx;
}

.nl-fill {
  margin: 16rpx 0 0;
  background: #03234b;
  color: #ffffff;
  font-weight: 700;
  font-size: 28rpx;
  border-radius: 0;
}

.nl-fill::after {
  border: none;
}

.nl-notes {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #425978;
  line-height: 1.4;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #03234b;
}

.field input,
.picker {
  font-weight: 400;
  font-size: 28rpx;
  color: #03234b;
  border: 2rpx solid #dbdee1;
  background: #ffffff;
  min-height: 80rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.submit {
  margin: 0;
  background: #ffd200;
  color: #03234b;
  font-weight: 700;
  font-size: 32rpx;
  min-height: 88rpx;
  border-radius: 0;
}

.submit::after {
  border: none;
}

.submit-bar {
  position: sticky;
  bottom: 0;
  z-index: 8;
  background: #ffffff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.results {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #ffffff;
}

.card-head {
  background: #03234b;
  color: #ffffff;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-head.top {
  background: #ffd200;
  color: #03234b;
}

.pn {
  font-size: 30rpx;
  font-weight: 700;
}

.facts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 24rpx 0;
}

.chip {
  background: #eeeff1;
  color: #03234b;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
}

.lists {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 24rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #03234b;
}

.list-title {
  display: block;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.line {
  display: block;
}

.meta {
  padding: 0 8rpx 8rpx;
  color: #425978;
  font-size: 24rpx;
  line-height: 1.45;
}
